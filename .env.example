# Supabase project settings (Project Settings -> API in the Supabase dashboard)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Only used server-side, inside the Supabase Edge Function.
# Set this with: supabase secrets set AI_API_KEY=sk-ant-...
# NEVER put this in a VITE_ variable — that would ship it to the browser.

